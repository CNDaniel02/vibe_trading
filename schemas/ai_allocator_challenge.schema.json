{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "chase_risk": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "confidence_adjustment": {
      "maximum": 0.25,
      "minimum": -1,
      "type": "number"
    },
    "contradictions": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "event_risk": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "hard_veto_reasons": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "critical_fact_conflict",
              "out_of_snapshot_evidence",
              "temporal_integrity_failure",
              "stale_decision_critical_evidence",
              "missing_required_primary_source",
              "mandate_horizon_invalid"
            ]
          },
          "detail": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "code",
          "detail"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "missing_evidence": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "objections": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "recommendation": {
      "enum": [
        "proceed",
        "reduce_confidence",
        "no_trade"
      ]
    },
    "soft_concerns": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "enum": [
              "uncertainty",
              "partial_price_in",
              "valuation",
              "secondary_evidence_gap",
              "chase_risk",
              "event_risk",
              "price_action_conflict",
              "incomplete_context",
              "other"
            ]
          },
          "detail": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "code",
          "detail"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "stale_evidence": {
      "items": {
        "type": "string"
      },
      "type": "array"
    }
  },
  "required": [
    "objections",
    "contradictions",
    "missing_evidence",
    "stale_evidence",
    "chase_risk",
    "event_risk",
    "recommendation",
    "confidence_adjustment",
    "hard_veto_reasons",
    "soft_concerns"
  ],
  "type": "object"
}
