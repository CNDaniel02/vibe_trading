{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "action": {
      "enum": [
        "buy",
        "hold",
        "exit",
        "no_trade"
      ]
    },
    "confidence": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
    },
    "contrary_evidence": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "entry_condition": {
      "type": "string"
    },
    "exit_condition": {
      "type": "string"
    },
    "invalidation_condition": {
      "type": "string"
    },
    "max_holding_period": {
      "type": "string"
    },
    "no_trade_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "supporting_evidence": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "thesis": {
      "type": "string"
    },
    "ticker": {
      "type": "string"
    }
  },
  "required": [
    "action",
    "ticker",
    "thesis",
    "supporting_evidence",
    "contrary_evidence",
    "entry_condition",
    "invalidation_condition",
    "exit_condition",
    "confidence",
    "max_holding_period",
    "no_trade_reason"
  ],
  "type": "object"
}
