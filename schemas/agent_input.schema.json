{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_context": {
      "type": "object"
    },
    "available_news": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "data_cutoff_time": {
      "format": "date-time",
      "type": "string"
    },
    "decision_time": {
      "format": "date-time",
      "type": "string"
    },
    "market_data": {
      "type": "object"
    },
    "market_session": {
      "enum": [
        "pre_market",
        "regular",
        "after_hours",
        "closed"
      ]
    },
    "snapshot_id": {
      "minLength": 1,
      "type": "string"
    },
    "source_metadata": {
      "items": {
        "type": "object"
      },
      "type": "array"
    },
    "technical_signals": {
      "type": "object"
    },
    "ticker": {
      "pattern": "^[A-Z][A-Z0-9.-]{0,9}$",
      "type": "string"
    }
  },
  "required": [
    "snapshot_id",
    "decision_time",
    "data_cutoff_time",
    "ticker",
    "market_session",
    "market_data",
    "technical_signals",
    "available_news",
    "source_metadata"
  ],
  "type": "object"
}
